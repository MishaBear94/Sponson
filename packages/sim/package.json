{
  "name": "@sponson/sim",
  "version": "0.3.0",
  "description": "Local fake cloud for Sponson: Vercel, Neon and Clerk API subsets with chaos injection.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MishaBear94/Sponson.git",
    "directory": "packages/sim"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "sponson-sim": "./src/bin.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b && node -e \"const fs=require('node:fs');if(!fs.existsSync('./dist/index.js'))throw new Error('prepack: ./dist/index.js missing after build - refusing to pack an empty package');fs.copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {},
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "sponson-sim": "./dist/bin.js"
    }
  },
  "homepage": "https://github.com/MishaBear94/Sponson#readme",
  "bugs": {
    "url": "https://github.com/MishaBear94/Sponson/issues"
  }
}

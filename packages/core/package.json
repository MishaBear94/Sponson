{
  "name": "@sponson/core",
  "version": "0.3.0",
  "description": "Plan model, planner, execution engine, receipt stores and adapter interfaces for Sponson.",
  "keywords": [
    "sponson",
    "release",
    "preview-environments",
    "deployment",
    "ci",
    "vercel",
    "neon",
    "clerk",
    "release-plan",
    "receipts",
    "drift-detection"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MishaBear94/Sponson.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/fake.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b && node -e \"const fs=require('node:fs');if(!fs.existsSync('./dist/index.js'))throw new Error('prepack: ./dist/index.js missing after build - refusing to pack an empty package');fs.copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.6.5"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/fake.d.ts",
        "default": "./dist/testing/fake.js"
      }
    }
  },
  "homepage": "https://sponson.mintlify.site",
  "bugs": {
    "url": "https://github.com/MishaBear94/Sponson/issues"
  }
}

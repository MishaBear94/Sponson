{
  "name": "@sponson/adapters",
  "version": "0.3.0",
  "description": "The built-in resource adapters and secret sources for Sponson.",
  "keywords": [
    "sponson",
    "release",
    "preview-environments",
    "deployment",
    "ci",
    "vercel",
    "neon",
    "clerk",
    "adapters",
    "secrets"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MishaBear94/Sponson.git",
    "directory": "packages/adapters"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b && node -e \"const fs=require('node:fs');if(!fs.existsSync('./dist/index.js'))throw new Error('prepack: ./dist/index.js missing after build - refusing to pack an empty package');fs.copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@sponson/core": "workspace:*"
  },
  "devDependencies": {
    "@sponson/sim": "workspace:*"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "homepage": "https://sponson.mintlify.site",
  "bugs": {
    "url": "https://github.com/MishaBear94/Sponson/issues"
  }
}

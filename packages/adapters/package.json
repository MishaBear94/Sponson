  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@sponson/core": "workspace:*"
  },

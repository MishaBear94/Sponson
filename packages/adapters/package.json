{
  "name": "@sponson/adapters",
  "version": "0.2.0",
  "description": "Resource adapters (Neon, Vercel, Clerk) and secret sources (env, doppler, op) for Sponson.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sponson/sponson.git",
    "directory": "packages/adapters"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b && node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "dependencies": {
    "@sponson/core": "workspace:*"
  },
  "devDependencies": {
    "@sponson/sim": "workspace:*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}

        "bearer_env": "WORKOS_API_KEY"
      }
    },
    "key": "/user_management/redirect_uris?limit=100[uri=https://pr-42.preview.example.com/callback]",
    "id": "DELETE /user_management/redirect_uris/ID"
  }

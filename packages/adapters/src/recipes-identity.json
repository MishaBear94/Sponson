{
  "cloudflare.dns_cname": {
    "provider": {
      "base_url": "https://api.cloudflare.com/client/v4",
      "base_url_env": "CLOUDFLARE_API_URL",
      "auth": {
        "bearer_env": "CLOUDFLARE_API_TOKEN"
      }
    },
    "key": "/zones/023e105f4ecef8ad9ca31a8372d0c353/dns_records?type=CNAME&name.exact=pr-42.preview.example.com[name=pr-42.preview.example.com,type=CNAME]",
    "id": "DELETE /zones/023e105f4ecef8ad9ca31a8372d0c353/dns_records/ID"
  },
  "stripe.webhook_endpoint": {
    "provider": {
      "base_url": "https://api.stripe.com/v1",
      "base_url_env": "STRIPE_API_URL",
      "auth": {
        "bearer_env": "STRIPE_SECRET_KEY"
      },
      "encoding": "form",
      "refuse_credential": {
        "prefixes": [
          "sk_live_",
          "rk_live_"
        ],
        "unless_env": "SPONSON_STRIPE_ALLOW_LIVE"
      }
    },
    "key": "/webhook_endpoints?limit=100[/metadata/sponson_endpoint=preview-pr-42]",
    "id": "DELETE /webhook_endpoints/ID"
  },
  "stripe.product": {
    "provider": {
      "base_url": "https://api.stripe.com/v1",
      "base_url_env": "STRIPE_API_URL",
      "auth": {
        "bearer_env": "STRIPE_SECRET_KEY"
      },
      "encoding": "form",
      "refuse_credential": {
        "prefixes": [
          "sk_live_",
          "rk_live_"
        ],
        "unless_env": "SPONSON_STRIPE_ALLOW_LIVE"
      }
    },
    "key": "/products/pro-pr-42",
    "id": "POST /products/pro-pr-42 body={\"active\":false}"
  },
  "stripe.price": {
    "provider": {
      "base_url": "https://api.stripe.com/v1",
      "base_url_env": "STRIPE_API_URL",
      "auth": {
        "bearer_env": "STRIPE_SECRET_KEY"
      },
      "encoding": "form",
      "refuse_credential": {
        "prefixes": [
          "sk_live_",
          "rk_live_"
        ],
        "unless_env": "SPONSON_STRIPE_ALLOW_LIVE"
      }
    },
    "key": "/prices?lookup_keys[]=pro-monthly-pr-42&active=true&limit=10[/recurring/interval=month,active=true,currency=usd,lookup_key=pro-monthly-pr-42,product=pro-pr-42,unit_amount=1500]",
    "id": "POST /prices/ID body={\"active\":false}"
  },
  "stripe.coupon": {
    "provider": {
      "base_url": "https://api.stripe.com/v1",
      "base_url_env": "STRIPE_API_URL",
      "auth": {
        "bearer_env": "STRIPE_SECRET_KEY"
      },
      "encoding": "form",
      "refuse_credential": {
        "prefixes": [
          "sk_live_",
          "rk_live_"
        ],
        "unless_env": "SPONSON_STRIPE_ALLOW_LIVE"
      }
    },
    "key": "/coupons/preview-pr-42",
    "id": "DELETE /coupons/preview-pr-42"
  },
  "stytch.redirect_url": {
    "provider": {
      "base_url": "https://management.stytch.com",
      "base_url_env": "STYTCH_MANAGEMENT_API_URL",
      "auth": {
        "basic": {
          "user_env": "STYTCH_WORKSPACE_KEY_ID",
          "password_env": "STYTCH_WORKSPACE_KEY_SECRET"
        }
      }
    },
    "key": "/pwa/v3/projects/my-app/environments/test/redirect_urls/all[url=https://pr-42.preview.example.com/authenticate]",
    "id": "DELETE /pwa/v3/projects/my-app/environments/test/redirect_urls?url=ID&do_not_promote_defaults=true"
  },
  "turso.database_branch": {
    "provider": {
      "base_url": "https://api.turso.tech/v1",

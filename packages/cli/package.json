{
  "name": "sponson",
  "version": "0.2.0",
  "description": "One release, one plan. CLI and MCP server for Sponson.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sponson/sponson.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "sponson": "./src/bin.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b && node -e \"const fs=require('node:fs');if(!fs.existsSync('./dist/index.js'))throw new Error('prepack: ./dist/index.js missing after build - refusing to pack an empty package');fs.copyFileSync('../../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "@sponson/core": "workspace:*",
    "@sponson/adapters": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "commander": "^15.0.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "sponson": "./dist/bin.js"
    }
  }
}

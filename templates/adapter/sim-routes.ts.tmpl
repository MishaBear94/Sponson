/**
 * Simulated __Name__: named items per project. Generated by `pnpm new:adapter __name__`.
 *
 * Assumptions about the real API that this fake encodes and that are most likely wrong. Number them, keep them
 * here, and pin the critical ones in scenarios/contract.test.ts (`assumption X1: …`) so `pnpm test:live` can
 * check them against a real account. TODO: replace these with what the __Name__ API docs say.
 *   X1. Creating an item whose name exists in the project answers 409.
 *   X2. The list is `{ items, next }`; `next` is an opaque cursor sent back as `?cursor=`, absent on the last page.
 *       Unpaginated unless chaos `page_size` is set.
 *   X3. Deletion is synchronous: the item is gone from the list when DELETE returns.
 *   X4. PATCH changes the value in place and keeps the id.
 */
import { page, Reply, route, router, type CreatedBy, type ProviderSim, type SimCore } from "../provider.js";

/** An item as the simulated __Name__ stores it, with the bookkeeping the sim adds (`createdBy`). */
export interface __Name__Item {
  id: string;
  name: string;
  value: string;
  createdAt: number;
  createdBy: CreatedBy;
}

/** The simulated __Name__'s state: items per project. */
export interface __Name__State {
  projects: Record<string, { items: __Name__Item[] }>;
}

/** What a scenario or test seeds the simulated __Name__ with (`seed: { __name__: … }`). */
export interface __Name__Seed {
  /** Project id → items that already exist (created "by a human", so unmanaged). */
  projects: Record<string, Array<{ name: string; value: string }>>;
}

/** The simulated __Name__ API, registered in `PROVIDERS` (packages/sim/src/state.ts) and served under `/__name__`. */
export const __name__Sim: ProviderSim<__Name__State, __Name__Seed> = {
  env: { token: "__NAME___TOKEN", url: "__NAME___API_URL", testToken: "tok___name__" },
  defaultSeed: { projects: { demo: [] } },

  reset(core, seed) {
    const projects: __Name__State["projects"] = {};
    for (const [id, items] of Object.entries(seed?.projects ?? {})) {
      projects[id] = { items: items.map((i) => item(core, i.name, i.value, "sim")) };
    }
    return { projects };
  },

  /**
   * `item.<name>` or `__name__:<project>.item.<name>`: a new value, "delete", or "recreate" (same name and value,
   * new id) — what a human in the __Name__ console would do.
   */
  drift(core, state, { key, rest, value, only }) {
    if (!rest.startsWith("item.")) return false;
    const name = rest.slice("item.".length);
    const projects = Object.entries(state.projects).filter(([id]) => only === undefined || id === only);
    let hit = false;
    for (const [, p] of projects) {
      const found = p.items.filter((i) => i.name === name);
      for (const i of found) {
        hit = true;
        if (value === "delete") p.items = p.items.filter((x) => x !== i);
        else if (value === "recreate") p.items = [...p.items.filter((x) => x !== i), item(core, i.name, i.value, "sim")];
        else i.value = value;
      }
    }
    if (!hit) throw new Error(`drift ${key}: no item named ${name}`);
    return true;
  },

  routes(core, state, req) {
    return routes(core, state, req);
  },
};

/**
 * The API, one route per method and path. `:name` segments arrive URI-decoded in `params`, typed from the path.
 * A request no route matches gets the fallback.
 */
const routes = router<__Name__State>(
  [
    route("GET", "/projects/:project/items", ({ core, state, params, url }) => {
      const p = state.projects[params.project];
      if (!p) return new Reply(404, { error: "project not found" });
      const pg = page(core, p.items, url.searchParams.get("cursor"));
      return new Reply(200, { items: pg.items.map(publicItem), ...(pg.next === null ? {} : { next: String(pg.next) }) });
    }),

    route("POST", "/projects/:project/items", ({ core, state, params, body }) => {
      const p = state.projects[params.project];
      if (!p) return new Reply(404, { error: "project not found" });
      const b = (body ?? {}) as { name?: unknown; value?: unknown };
      if (typeof b.name !== "string" || b.name === "" || typeof b.value !== "string") return new Reply(400, { error: "name and value are required strings" });
      if (p.items.some((i) => i.name === b.name)) return new Reply(409, { error: "item already exists" });
      const i = item(core, b.name, b.value, "api");
      p.items.push(i);
      return new Reply(201, publicItem(i));
    }),

    route("GET", "/projects/:project/items/:id", ({ state, params }) => {
      const i = state.projects[params.project]?.items.find((x) => x.id === params.id);
      return i ? new Reply(200, publicItem(i)) : new Reply(404, { error: "item not found" });
    }),

    route("PATCH", "/projects/:project/items/:id", ({ state, params, body }) => {
      const i = state.projects[params.project]?.items.find((x) => x.id === params.id);
      if (!i) return new Reply(404, { error: "item not found" });
      const b = (body ?? {}) as { value?: unknown };
      if (typeof b.value !== "string") return new Reply(400, { error: "value is a required string" });
      i.value = b.value;
      return new Reply(200, publicItem(i));
    }),

    route("DELETE", "/projects/:project/items/:id", ({ state, params }) => {
      const p = state.projects[params.project];
      const i = p?.items.find((x) => x.id === params.id);
      if (!p || !i) return new Reply(404, { error: "item not found" });
      p.items = p.items.filter((x) => x !== i);
      return new Reply(200, { id: i.id, deleted: true });
    }),
  ],
  () => new Reply(404, { error: "not found" }),
);

function item(core: SimCore, name: string, value: string, createdBy: CreatedBy): __Name__Item {
  return { id: core.nextId("__name___"), name, value, createdAt: Date.now(), createdBy };
}

function publicItem(i: __Name__Item): { id: string; name: string; value: string } {
  return { id: i.id, name: i.name, value: i.value };
}

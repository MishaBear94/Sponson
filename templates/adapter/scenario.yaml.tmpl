# Generated by `pnpm new:adapter __name__`: the __Name__ adapter end to end through the CLI against the sim.
# Format: see the top of scenarios/runner.test.ts.
name: "__name__: create, apply twice without writes, drift refused until --reconcile, destroy"
plan: |
  version: 1
  providers:
    __name__: { project: demo }
  changes:
    - id: item
      adapter: __name__
      op: item
      value: hello
      environments: [preview]
steps:
  - run: plan --json
    expect:
      exit: 0
      plan_lines: { item: create }
  - run: apply --json
    expect:
      exit: 0
      status: complete
      lines: { item: applied }
      outputs: { item: { value: hello } }
  - sim:
      write_order: ["POST /__name__/projects/demo/items"]
  - run: apply --json
    expect:
      exit: 0
      writes: 0
      lines: { item: unchanged }
  # A human edits the value in the __Name__ console: plan reports it, apply refuses it until --reconcile.
  - chaos:
      drift: { "__name__.item.sponson-preview-pr-42": "edited" }
  - run: plan --json
    expect:
      exit: 1
      drift: [{ kind: changed, line: item }]
      plan_lines: { item: blocked }
  - run: apply --json
    expect:
      exit: 1
      status: failed
      lines: { item: blocked }
      errors: { item: "reconcile" }
  - run: apply --reconcile --json
    expect:
      exit: 0
      status: complete
      lines: { item: applied }
      outputs: { item: { value: hello } }
  - run: apply --destroy --json
    expect:
      exit: 0
      status: complete
      lines: { item: destroyed }
  - sim:
      write_order: ["POST /__name__", "PATCH /__name__", "DELETE /__name__/projects/demo/items/"]

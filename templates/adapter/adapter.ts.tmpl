/**
 * __Name__ adapter. Generated by `pnpm new:adapter __name__`; replace every TODO, then delete this paragraph.
 *
 * One op, `item`: a named value in a __Name__ project, created per scope and destroyed with it. It is a working
 * example against the sim routes in packages/sim/src/routes/__name__.ts — rename the op, its params and the
 * API paths to what __Name__ actually manages, keeping the shape: the rules every op must follow are in
 * CONTRIBUTING.md ("Adding an adapter") and on `OpSpec` in packages/core/src/types.ts.
 */
import { markerKind, sha256, type AdapterContext, type Literal, type OpSpec, type ResourceAdapter, type ResourceRecord } from "@sponson/core";
// Only the stable authoring API exported from `@sponson/adapters` (listed in CONTRIBUTING.md). In-tree adapters
// import it from ./common.js and ./http.js; an out-of-tree plugin imports the same names from "@sponson/adapters".
import { assertNoPending, clientFor, deleteIgnoringNotFound, diffValue, optionalEnv, paramError, requireEnv, requireProvider, stringParam } from "./common.js";
import { ShapeError, isObject, isProviderError, listAll, records, type ApiClient, type Page } from "./http.js";

const ADAPTER = "__name__";
/** The environment __Name__ reads; declared once, used by the code below and by the generated docs (`about`). */
const ABOUT = { credentialEnv: "__NAME___TOKEN", baseUrlEnv: "__NAME___API_URL" } as const;

// TODO: the real API's base URL.
/** __Name__'s API base URL. `__NAME___API_URL` overrides it; tests and scenarios point that at the sim. */
export const __NAME___DEFAULT_API_URL = "https://api.__name__.example/v1";

interface Item {
  id: string;
  name: string;
  value: string;
}

/** The HTTP client: credentials from the environment, the project from `providers.__name__.project`. */
function client(actx: AdapterContext): { api: ApiClient; project: string } {
  const token = requireEnv(actx.env, ABOUT.credentialEnv, ADAPTER);
  const project = requireProvider(actx, "project", ADAPTER);
  return { api: clientFor(actx, ADAPTER, { baseUrl: optionalEnv(actx.env, ABOUT.baseUrlEnv) ?? __NAME___DEFAULT_API_URL, token }), project };
}

const ITEM_PREFIX = "item:";

/**
 * The resource key. It must contain every dimension that makes two items distinct in __Name__; the project is
 * not part of it because the ledger already keys resources by provider block.
 */
function itemKey(name: string): string {
  return `${ITEM_PREFIX}${name}`;
}

/**
 * One resource per item, under the key its diff uses. `hash` must cover every field the plan controls: a field
 * left out is invisible to drift detection (a console edit of it goes unnoticed). With more fields, hash them
 * together, e.g. `sha256(canonicalJson({ value: i.value, note: i.note }))` (see `branchHash` in neon.ts), and
 * compare the desired fields the same way in `diff` and `apply`. Changing what the hash covers later is a
 * breaking change: see "Adding an adapter" in CONTRIBUTING.md.
 */
function record(i: Item): ResourceRecord {
  return { key: itemKey(i.name), id: i.id, hash: sha256(i.value), label: `__Name__ item ${i.name}` };
}

function outputsOf(i: Item): Record<string, Literal> {
  return { id: i.id, value: i.value };
}

/** Validate one item from a response body; a wrong shape is PROVIDER_RESPONSE naming the endpoint. */
function parseItem(body: unknown): Item {
  const [i] = records([body], "the item", ["id", "name", "value"]);
  return { id: i!.id, name: i!.name, value: i!.value };
}

/** Every item in the project, following `{ items, next }` cursors. TODO: match __Name__'s list and paging shape. */
async function list(api: ApiClient, project: string): Promise<Item[]> {
  return listAll(api, `/projects/${encodeURIComponent(project)}/items`, (body): Page<Item> => {
    if (!isObject(body)) throw new ShapeError(`expected { items, next }, got ${body === null ? "null" : typeof body}`);
    const items = records(body.items, "`items`", ["id", "name", "value"]).map((i) => ({ id: i.id, name: i.name, value: i.value }));
    return { items, next: typeof body.next === "string" ? { cursor: body.next } : null };
  });
}

function desiredValue(params: Record<string, unknown>): unknown {
  const v = params.value;
  if (v === undefined || v === null) throw paramError(ADAPTER, "param `value` is required", "value");
  return v;
}

const item: OpSpec = {
  outputs: { id: { available: "immediate" }, value: { available: "immediate" } },

  /** One item per scope unless the plan names it. */
  defaults(params, ctx) {
    return { name: `sponson-${ctx.env}-${ctx.scope}`, ...params };
  },

  // TODO: if items belong to a deployment environment (like Vercel's `target`), implement writesEnvironment()
  // so that a line writing to production requires approval.

  async read(actx, params) {
    // The name may come from another line that has not been applied yet: nothing to read.
    if (markerKind(params.name) !== null) return null;
    const name = stringParam(params, "name", ADAPTER);
    const { api, project } = client(actx);
    const found = (await list(api, project)).find((i) => i.name === name);
    if (!found) return null;
    return { resources: [record(found)], outputs: outputsOf(found) };
  },

  diff(live, params) {
    const name = params.name;
    const key = markerKind(name) !== null ? `${ITEM_PREFIX}(pending)` : itemKey(String(name));
    const current = live?.resources.find((r) => r.key === key);
    const shown = live?.outputs.value;
    // TODO: pass `sensitive: true` (and no liveValue) if the value may be a secret.
    return [diffValue({ key, label: `__Name__ item ${String(name)}`, live: current, desired: desiredValue(params), sensitive: false, ...(shown !== undefined ? { liveValue: String(shown) } : {}) })];
  },

  async apply(actx, params, live) {
    assertNoPending(params, ADAPTER);
    const name = stringParam(params, "name", ADAPTER);
    const desired = desiredValue(params);
    const keep = markerKind(desired) === "keep";
    const key = itemKey(name);
    const { api, project } = client(actx);
    const base = `/projects/${encodeURIComponent(project)}/items`;

    const update = async (current: { id: string; hash: string }, created: string[]) => {
      if (keep || current.hash === sha256(String(desired))) return null;
      actx.log(`update ${name}`);
      const i = await api.patch(`${base}/${encodeURIComponent(current.id)}`, { value: String(desired) }, parseItem);
      return { resources: [record(i)], outputs: outputsOf(i), created };
    };

    const current = live?.resources.find((r) => r.key === key);
    if (current) return (await update(current, [])) ?? { resources: live!.resources, outputs: live!.outputs, created: [] };
    if (keep) throw paramError(ADAPTER, `item ${name} is declared \`{ keep: true }\` but does not exist`, "value");

    // Announce the create before sending it: a crash or a lost response must not orphan the item.
    await actx.intend([key]);
    actx.log(`create ${name}`);
    try {
      const i = await api.post(base, { name, value: String(desired) }, parseItem);
      return { resources: [record(i)], outputs: outputsOf(i), created: [key] };
    } catch (e) {
      if (!isProviderError(e, "PROVIDER_CONFLICT")) throw e;
      // It exists already: created by someone else, or by an earlier attempt of ours whose answer was lost.
      // Not created by this call; the engine claims it if an earlier intent of ours named it.
      const found = (await list(api, project)).find((i) => i.name === name);
      if (!found) throw e;
      return (await update({ id: found.id, hash: sha256(found.value) }, [])) ?? { resources: [record(found)], outputs: outputsOf(found), created: [] };
    }
  },

  async destroy(actx, resources) {
    const { api, project } = client(actx);
    for (const r of resources) await deleteIgnoringNotFound(api, `/projects/${encodeURIComponent(project)}/items/${encodeURIComponent(r.id)}`);
  },

  /** Every item in the project, for drift (`unmanaged`) and `sponson init`. */
  async listScope(actx) {
    const { api, project } = client(actx);
    return (await list(api, project)).map(record);
  },

  /** One line per item; the value is never copied into the plan. */
  adopt(resources) {
    return resources.map((r) => ({ id: "item", params: { name: r.key.slice(ITEM_PREFIX.length), value: { keep: true } }, keys: [r.key] }));
  },
};

/**
 * The __Name__ adapter (`adapter: __name__` in a plan). Registered in `createRegistry()`; needs `__NAME___TOKEN`
 * and `providers.__name__.project`.
 */
export const __name__Adapter: ResourceAdapter = { name: ADAPTER, ops: { item }, about: ABOUT };
